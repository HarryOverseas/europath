# Server & Vercel Configuration
PORT=5000
JWT_SECRET=harry_global_secret_key_2026_secure

# Database Configuration
# Local Development: DB_PATH=./database.sqlite
# Vercel Production: Provide DATABASE_URL for PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# If DATABASE_URL is not set on Vercel, it falls back to /tmp/database.sqlite
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_PATH=./database.sqlite

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password
ADMIN_EMAIL=admin@harryglobal.com

# Email / SMTP Notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=admin@harryglobal.com
EMAIL_PASS=sample_app_password

# WhatsApp Meta Cloud API
WHATSAPP_API_TOKEN=sample_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=123456789

# Chatbot — Claude AI (optional)
# When set, the chatbot uses Claude claude-haiku-5-5 for intelligent replies.
# Leave blank to use the built-in rule-based fallback.
ANTHROPIC_API_KEY=
