# Server & Vercel Configuration
PORT=5000
# Generate 512-bit hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_512_bit_hex_secret_here

# Payload Obfuscation & Encryption (AES-256-GCM)
# Generate 256-bit hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=your_256_bit_hex_secret_here
VITE_PAYLOAD_SECRET=your_256_bit_hex_secret_here

# Database Configuration
# Local Development: DB_PATH=./database.sqlite
# Vercel Production: Provide DATABASE_URL for PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# If DATABASE_URL is not set on Vercel, it falls back to /tmp/database.sqlite
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_PATH=./database.sqlite

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password
ADMIN_EMAIL=admin.harryoverseas@gmail.com

# Multi-Inbox Email Notification Routing
EMAIL_ADMIN=admin.harryoverseas@gmail.com
EMAIL_INFO=info.harryoverseas@gmail.com
EMAIL_SUPPORT=support.harryoverseas@gmail.com

# Email / SMTP Transport (Gmail requires a 16-character Google App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=info.harryoverseas@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# WhatsApp Meta Cloud API
WHATSAPP_API_TOKEN=sample_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=123456789

# Slack Incoming Webhook Notifications
# Create a webhook URL in your Slack workspace: https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here
# Optional channel-specific overrides:
# SLACK_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/... (#leads)
# SLACK_CAREERS_WEBHOOK_URL=https://hooks.slack.com/services/... (#careers)
# SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/... (#alerts)

# Chatbot — Claude AI (optional)
# When set, the chatbot uses Claude claude-haiku-5-5 for intelligent replies.
# Leave blank to use the built-in rule-based fallback.
ANTHROPIC_API_KEY=
